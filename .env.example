# Copie para .env e ajuste. Nunca versione o .env.

# PostgreSQL local (usuário/senha definidos na instalação do PostgreSQL)
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/sistema_bar

# Segredo para assinar os tokens de acesso (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Segredo que protege os CPFs no banco (mínimo 32 caracteres). Gere igual ao JWT_SECRET.
# ATENÇÃO: não troque depois de ter comandas, ou os CPFs gravados ficam ilegíveis e sem busca.
CPF_SECRET=troque-por-outro-segredo-aleatorio-com-pelo-menos-32-caracteres

# Porta da API (em desenvolvimento o Vite faz proxy de /api para cá)
PORT=3000
HOST=0.0.0.0

# HTTPS (gerado por scripts/gerar-certificado.ps1). Se vazio, a API sobe em HTTP.
# Em desenvolvimento deixe vazio: o HTTPS fica no Vite (porta 5173).
HTTPS_CERT=
HTTPS_KEY=

# Senha do admin criado pelo seed. Se vazio, o seed gera uma aleatória e mostra no terminal.
SEED_ADMIN_PASSWORD=
